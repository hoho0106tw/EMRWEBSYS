    <client>
      <endpoint address="https://intra5.femh.org.tw:65534/OPENEMRVIEW/Service1.asmx"
        binding="basicHttpBinding" bindingConfiguration="Service1Soap"
        contract="OPENEMRVIEW.Service1Soap" name="Service1Soap" />
      <endpoint address="https://webap.femh.org.tw:9005/UpdatePatImage/Service.asmx"
