@{ string uniqueId = ViewData["UniqueId"]?.ToString() ?? Guid.NewGuid().ToString("N"); }


<div id="loading_@ViewData["UniqueId"]">
    <img src="~/images/ajax-loader.gif" />
</div>
<style type="text/css">
    div#loading_@ViewData["UniqueId"] {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        /*
        margin-top: -33px;
        margin-left: -33px;
        */
        transform: translate(-50%, -50%);
    }
</style>
<script type="text/javascript">


    $(window).on("load", function () {

        var uniqueId = "@uniqueId";

    $(document).ajaxStart(function () {
        $("#loading_" + uniqueId).show();
    });
    $(document).ajaxStop(function () {
        $("#loading_" + uniqueId).hide();
    });
  });
</script>
