
<script>
    $(document).ready(function () {
        // 先隐藏所有页面，只显示 EMRPage
     //  $('#EMRPage, #AuditPage, #FakePage, #SummaryPage').hide();
      //  $('#EMRPage').show(); // 默认显示 EMRPage

        $('#titlebar a').click(function () {
            var page = $(this).text().trim() + 'Page'; // 获取对应的 ID，例如 'AuditPage'          
            // 隐藏所有页面
            $('#EMRPage, #AuditPage, #FakePage, #SummaryPage').hide();

            // 显示当前点击的页面
            $('#' + page).show();

            // 解析 EasyUI 样式
           // $.parser.parse();
        });
    });

</script>



<div id="cc" class="easyui-layout" style="width: 100%; height: 100% ">

    <div data-options="region:'west',split:true,collapsed:true,
                hideExpandTool: true,
                expandMode: null,
                hideCollapsedContent: false,
                collapsedSize: 80,
                collapsedContent: function(){
                    return $('#titlebar');
                }
                " title="West" style="width:100px;"></div>

    <div data-options="region:'center'">
        <div id="EMRPage">
            @Html.Partial("EMR")           
        </div>

        <div id="AuditPage"  style="display:none">
            @Html.Partial("Audit")
        </div>

        <div  id="FakePage" style="display:none">
            @Html.Partial("Fake")
        </div>

        @*<div id="SummaryPage" style="display:none">
            @Html.Partial("Summary")
        </div>*@
    </div>

            <div id="titlebar" style="padding:2px">
                <a class="easyui-linkbutton" style="width:100%" data-options="iconCls:'icon-large-EMR',size:'large',iconAlign:'top'">EMR</a>
                <a class="easyui-linkbutton" style="width:100%" data-options="iconCls:'icon-large-AUDIT',size:'large',iconAlign:'top'">Audit</a>
                @*<a class="easyui-linkbutton" style="width:100%" data-options="iconCls:'icon-large-Summary',size:'large',iconAlign:'top'">Summary</a>*@
                <a class="easyui-linkbutton" style="width:100%" data-options="iconCls:'icon-large-Fake',size:'large',iconAlign:'top'">Fake</a>
            </div>

        </div>




