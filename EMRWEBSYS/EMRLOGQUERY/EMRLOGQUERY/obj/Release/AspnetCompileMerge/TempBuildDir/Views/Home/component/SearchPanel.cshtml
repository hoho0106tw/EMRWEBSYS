
@{ string uniqueId = ViewData["UniqueId"]?.ToString() ?? Guid.NewGuid().ToString("N"); }

<script type="text/javascript">
    $(window).on("load", function () {
        var uniqueId = "@uniqueId"; // Razor 传递 C# 变量给 JavaScript
        console.log("Unique ID:", uniqueId); // 调试用

        // 确保 EasyUI 组件初始化
        $("#StartDate_" + uniqueId).datebox({
            required: true,
            formatter: function(date) {
                return date.toLocaleDateString("en-US");
            },
            parser: function(s) {
                var t = Date.parse(s);
                return !isNaN(t) ? new Date(t) : new Date();
            }
        });


        // 确保 EasyUI 组件初始化
        $("#EndDate_" + uniqueId).datebox({
            required: true,
            formatter: function (date) {
                return date.toLocaleDateString("en-US");
            },
            parser: function (s) {
                var t = Date.parse(s);
                return !isNaN(t) ? new Date(t) : new Date();
            }
        });

        // 设置默认日期
        var today = new Date();
        var lastYear = new Date();
        lastYear.setFullYear(today.getFullYear() - 1);

        $("#StartDate_" + uniqueId).datebox("setValue", lastYear.toLocaleDateString("en-US"));
        $("#EndDate_" + uniqueId).datebox("setValue", today.toLocaleDateString("en-US"));

        GETSYSTEM(uniqueId);
        GETCombDoctype('', uniqueId);
        //初始化
        $('#TextPatNO_' + uniqueId).textbox();

        initializeSearch(uniqueId);

    });
</script>


<script type="text/javascript">

    function subtractYears(numOfYears, date = new Date()) {
        date.setFullYear(date.getFullYear() - numOfYears);
        return date;
    }

        //驗證開始時間小於結束時間
        $.extend($.fn.validatebox.defaults.rules, {
            valid: {
                validator: function (value, param) {

                    var uniqueId = "@uniqueId";

                    var startDate = $("#StartDate_" + uniqueId).val();
                    var endtDate = $("#StartDate_" + uniqueId).val();
                    if (startDate == '' || endtDate=='') {
                        return true;
                    }
                    var startTmp = new Date(startDate.replace(/-/g, "/"));
                    var endTmp = new Date(endtDate.replace(/-/g, "/"));
                    return startTmp <= endTmp;
                },
                message: '結束時間要大於開始時間！'
            }
        })


    function GETSYSTEM(uniqueId) {
            //後臺請求url
              var url = '@Url.Action("combSystem", "component")';
             $.getJSON(url, function (json) {

                  $('#combSystem_' + uniqueId).combobox('clear');
                  $('#combSystem_' + uniqueId).combobox({
                      data: json,//獲取要顯示的json資料
                      valueField: 'scode',
                      textField: 'sContent',
                      selected: "selected",
                      onChange: function (value) {
                          GETCombDoctype(value, uniqueId);
                      }

                  }
                  );
              });
        }


    function GETCombDoctype(SYSCODE, uniqueId) {
            //後臺請求url
        var url = '@Html.Raw(@Url.Action("combDoctype", "component"))' + '?SYSCODE=' + SYSCODE;



     $.getJSON(url, function (json) {
         $('#combDoctype_' + uniqueId).combobox('clear');
         $('#combDoctype_' + uniqueId).combobox({
                data: json,//獲取要顯示的json資料
                valueField: 'scode',
                textField: 'sContent',
                selected:"selected"
            });
        });
    }

</script>




<script type="text/javascript">
    function loadDataIntoJqxTree(selector, data) {
        if (data === null) {
            // If data is null, clear the tree
            $(selector).jqxTree('clear'); // Clear the tree data

            // Determine the target content panel based on the selector
            if (selector === "#jqxTree") {
                $("#ContentPanel").html(''); // Clear the first content panel
            } else if (selector === "#jqxTree2") {
                $("#ContentPanel2").html(''); // Clear the second content panel
            }

        } else {
            // Otherwise, load the new data into the tree
            $(selector).jqxTree({
                source: data,
                checkboxes: true, 
                theme: "summer",
                width: "100%",
                height: "100%"
            });
        }

        // Refresh the tree to reflect the changes (even when clearing)
        $(selector).jqxTree('refresh');
    }

    function initializeSearch(uniqueId) {
        if (uniqueId == 'EMR') {

            if (!$("#btnSearch_" + uniqueId).data("isBound")) {
                $("#btnSearch_" + uniqueId).data("isBound", true); // 設定標記，防止重複綁定

                $("#btnSearch_" + uniqueId).bind("click", function () {
                    // 初始化
                    $("#ContentPanel").html('');
                    // 使用 EasyUI 方法取得當前選中的 Tab
                    const activeTab = $(".easyui-tabs").tabs("getSelected");
                    if (!activeTab) return;

                    const title = activeTab.panel("options").title;

                    var startDate = $("#StartDate_" + uniqueId).val();
                    var endDate = $("#EndDate_" + uniqueId).val();
                    var combSystem = $("#combSystem_" + uniqueId).combobox("getValue");
                    var combDoctype = $("#combDoctype_" + uniqueId).combobox("getValue");
                    var textPatNo = $("#TextPatNO_" + uniqueId).val();
                    var combsign = $("#combsign_" + uniqueId).combobox("getValue");
                    var model = [startDate, endDate, combSystem, combDoctype, textPatNo, title, combsign];

                    var url = '@Html.Raw(@Url.Action("btnSearch", "component"))';

                    $.ajax({
                        url: url,
                        data: JSON.stringify(model),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        async: true,
                        success: function (data) {
                            if (data.MSG != null) {
                                showMessage("提示訊息", data.MSG);

                                if (title === "監控中心") {
                                    loadDataIntoJqxTree("#jqxTree", null)
                                } else if (title === "收發作業") {
                                    loadDataIntoJqxTree("#jqxTree2", null)
                                }

                            } else {
                                if (title === "監控中心") {                           
                                    loadDataIntoJqxTree("#jqxTree", data)
                                } else if (title === "收發作業") {                                  
                                    loadDataIntoJqxTree("#jqxTree2", data)
                                }
                            }
                        },
                        error: function (data) {
                            $.messager.alert("Error", "失敗: " + data[0], "error");
                        },
                    });
                });
            }
        }
        else if (uniqueId == 'Audit') {

          if (!$("#btnSearch_" + uniqueId).data("isBound")) {
              $("#btnSearch_" + uniqueId).data("isBound", true); // 設定標記，防止重複綁定

             $("#btnSearch_" + uniqueId).bind("click", function () {
                // 初始化
              //  $("#ContentPanel").html('');

                // 使用 EasyUI 方法取得當前選中的 Tab
                const activeTab = $(".easyui-tabs").tabs("getSelected");
                if (!activeTab) return;

                const title = activeTab.panel("options").title;

                var startDate = $("#StartDate_" + uniqueId).val();
                var endDate = $("#EndDate_" + uniqueId).val();
                var combSystem = $("#combSystem_" + uniqueId).combobox("getValue");
                var combDoctype = $("#combDoctype_" + uniqueId).combobox("getValue");
                var textPatNo = $("#TextPatNO_" + uniqueId).val();

                var model = [startDate, endDate, combSystem, combDoctype, textPatNo, title];
                 var url = '@Html.Raw(@Url.Action("btnSearch_Audit", "component"))';


                 $.ajax({
                     url: url,
                     data: JSON.stringify(model),
                     type: "POST",
                     contentType: "application/json;charset=utf-8",
                     async: true,
                     success: function (data) {
                         if (data.MSG != null) {
                             showMessage("提示訊息", data.MSG);
                         } else if (data.length > 0) {
                             $("#datagrid").datagrid("loadData", data);
                         }
                     },
                     error: function (xhr, status, error) {
                         $.messager.alert("Error", "失敗: " + error, "error");
                     }
                 });

            });
        }
       }

    }


    function showMessage(title, message) {
        $.messager.show({
            title: title,
            msg: message,
            showType: "show",
        });
    }


</script>





<div class="container-fluid mt-3">
    <div class="row align-items-center">
        <div class="col-auto">
            日期:
        </div>
        <div class="col-auto">
            <input class="easyui-datebox" required style="width:125px;"
                   id="StartDate_@ViewData["UniqueId"]" validType="valid">
        </div>
        <div class="col-auto">~</div>
        <div class="col-auto">
            <input class="easyui-datebox" required style="width:125px;"
                   id="EndDate_@ViewData["UniqueId"]" validType="valid">
        </div>

        <div class="col-auto">
            系統別:
        </div>
        <div class="col-auto">
            <select class="easyui-combobox" id="combSystem_@ViewData["UniqueId"]"
                    style="width:140px;"></select>
        </div>

        <div class="col-auto">
            文件別:
        </div>
        <div class="col-auto">
            <select class="easyui-combobox" id="combDoctype_@ViewData["UniqueId"]"
                    style="width:180px;"></select>
        </div>

        <div class="col-auto">
            病歷號:
        </div>
        <div class="col-auto">
            <input class="easyui-textbox" style="width:85px;"
                   id="TextPatNO_@ViewData["UniqueId"]" data-options="required:true">
        </div>

        <div class="col-auto">
            <a href="#" id="btnSearch_@ViewData["UniqueId"]" class="easyui-linkbutton"
               data-options="iconCls:'icon-search'" style="width:80px;">Search</a>
        </div>
    </div>
</div>
