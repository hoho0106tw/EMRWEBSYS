<style>
    #MyPopup .modal-dialog {
        width: 95vw;
        max-width: 100%;
        height: 95vh;
        max-height: 95vh;
    }

    #MyPopup .modal-content {
        height: 100%;
    }

    #MyPopup .close {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 24px;
        color: red; /* 修改这里，使 "X" 为红色 */
        opacity: 0.5;
    }

        #MyPopup .close:hover {
            color: #000;
            opacity: 1;
        }
</style>

<div id="MyPopup" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <!-- 关闭按钮 -->
                <button type="button" class="close" aria-label="Close" onclick="closeModal()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- 使用 iframe 替换原始内容 -->
                <iframe id="contentIframe" width="100%" height="100%" frameborder="0"></iframe>
            </div>
        </div>
    </div>
</div>

<script>
    function closeModal() {
        $("#MyPopup").modal("hide");
    }
</script>